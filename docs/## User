        return BaseResponse(code=404, message="订单不存在")
    
    if order.status != 0:
        return BaseResponse(code=400, message="订单状态不正确")
    
    if order.payment_method == "balance":
        if current_user.balance < order.amount:
            return BaseResponse(code=400, message="余额不足")
        
        current_user.balance -= order.amount
        order.status = 1
        order.paid_at = datetime.now()
        db.commit()
        
        if order.order_type == "permission":
            permission_type = order.product_name.split("-")[0].replace("权限", "")
            payment_mode = order.product_name.split("-")[1]
            
            if payment_mode == "per_use":
                count = int(order.product_name.split("-")[1].replace("次", ""))
                permission_service.grant_permission(
                    current_user.id, permission_type, "per_use", count=count
                )
            elif payment_mode == "monthly":
                permission_service.grant_permission(
                    current_user.id, permission_type, "monthly", days=30
                )
            elif payment_mode == "yearly":
                permission_service.grant_permission(
                    current_user.id, permission_type, "yearly", days=365
                )
        elif order.order_type == "balance":
            current_user.balance += order.amount
            db.commit()
        
        return BaseResponse(message="支付成功")
    
    result = await payment_service.create_payment(
        payment_method=order.payment_method,
        order_no=order.order_no,
        amount=float(order.amount),
        description=order.product_name
    )
    
    if result.get("success"):
        return BaseResponse(
            message="支付链接生成成功",
            data={
                "pay_url": result.get("pay_url") or result.get("code_url"),
                "order_no": order.order_no
            }
        )
    else:
        return BaseResponse(code=400, message=result.get("error", "支付创建失败"))


