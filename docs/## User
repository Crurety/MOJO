        task = self.db.query(UserGrowth).filter(
            UserGrowth.user_id == user_id,
            UserGrowth.task_code == task_code,
            UserGrowth.status == 0
        ).first()
        
        if not task:
            return False
        
        task.progress = progress
        
        # 检查是否完成
        if progress >= task.target:
            task.status = 1
            task.completed_at = datetime.now()
        
        self.db.commit()
        return True
    
