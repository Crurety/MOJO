                user_id=user_id,
                participation_count=1,
                rewards=json.dumps(rewards, ensure_ascii=False) if rewards else None
            )
            self.db.add(participation)
            activity.current_participants += 1
        
        self.db.commit()
        
        return True, "参与成功", rewards or {}
    
