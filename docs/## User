def setup_tracing(app):
    """设置分布式追踪
    
    Args:
        app: FastAPI应用实例
    """
    # 创建资源
    resource = Resource.create({
        "service.name": settings.PROJECT_NAME,
        "service.version": settings.VERSION
    })
    
    # 创建TracerProvider
